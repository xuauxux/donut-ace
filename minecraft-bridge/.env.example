# Copy to .env in this folder (or set the same keys in the project .env).
# Nothing here is sent anywhere except your own site.

# Where the site runs. Local dev: php artisan serve (default port 8070).
# Falls back to the project .env APP_URL, with localhost pinned to 127.0.0.1.
MC_APP_URL=http://127.0.0.1:8070

# Must match MC_BRIDGE_SECRET in the site's .env exactly. Generate one with:
#   php -r "echo bin2hex(random_bytes(32));"
MC_BRIDGE_SECRET=

# The game server the bot joins.
MC_SERVER_HOST=play.donutsmp.net
MC_SERVER_PORT=25565
# Leave empty to let mineflayer ask the server for its version.
MC_SERVER_VERSION=

# The bot account. For a Microsoft (Java) account put the account email here and
# the first run prints a device-code link to approve. The token cache lands in
# this folder — keep it out of version control.
MC_BOT_USERNAME=
MC_BOT_AUTH=microsoft
